{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcofyStagingObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::itarang-ecofy-staging/ecofy/staging/*"
    },
    {
      "Sid": "EcofyStagingBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::itarang-ecofy-staging",
      "Condition": { "StringLikeIfExists": { "s3:prefix": ["ecofy/staging/*"] } }
    }
  ]
}
