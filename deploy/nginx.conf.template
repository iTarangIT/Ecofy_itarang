# Nginx vhost for the Ecofy Lead Workspace. deploy/server-setup.sh substitutes __DOMAIN__ and __PORT__
# and installs it at /etc/nginx/sites-available/<domain>; certbot then adds the TLS server block.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # CSV imports and document uploads
    client_max_body_size 25m;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:__PORT__;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
