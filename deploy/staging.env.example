# Server .env for sandbox-ecofy.itarang.com. Fill it in and paste the WHOLE file into the GitHub secret
# STAGING_ENV_FILE. The workflow writes it to /srv/ecofy/shared/.env (mode 600) on every deploy.
# It is never committed: .gitignore blocks .env and .env.*; this file is only a template.
NODE_ENV=production
PORT=3100

# Public origin + tenant host (must match the tenant_domains row in the database)
APP_BASE_URL=https://sandbox-ecofy.itarang.com
TENANT_HOSTS=sandbox-ecofy.itarang.com
COOKIE_SECURE=true

# Database: the ecofy_app role only. The OWNER url is NOT needed on the server
# (schema, seed and fixtures run from the office machine, whose IP the RDS security group allows).
DATABASE_URL=postgresql://ecofy_app:<password>@<rds-host>:5432/<db>?sslmode=require

# Supabase Auth. NEXT_PUBLIC_* are also read by the workflow at build time (inlined in the login page).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Adapters. Staging may stay on the dev drivers; production uses s3 / ses / gupshup / bullmq.
STORAGE_DRIVER=local
MAIL_DRIVER=dev
SMS_DRIVER=dev
QUEUE_DRIVER=inline

# Dev-driver paths. The release's .data is a symlink to /srv/ecofy/shared/data, so files survive deploys.
LOCAL_STORAGE_DIR=.data/storage
DEV_MAIL_DIR=.data/mail
DEV_SMS_DIR=.data/sms
LOCAL_SIGNING_SECRET=<32 random hex bytes: openssl rand -hex 32>

# Only needed once the drivers above are switched
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=ecofy/staging/
SES_FROM=no-reply@itarang.com
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=
SMS_WEBHOOK_SECRET=<random: openssl rand -hex 16>
REDIS_URL=redis://127.0.0.1:6379

SESSION_COOKIE_NAME=sb-access-token
REFRESH_COOKIE_NAME=sb-refresh-token
DEVICE_COOKIE_NAME=ecofy_device
LOG_LEVEL=info
