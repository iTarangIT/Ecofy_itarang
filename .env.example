# ---------------------------------------------------------------------------
# Ecofy Lead Workspace — environment
# Copy to .env.local and fill in. Never commit .env.local.
# `npm run db:init-env` derives most of this from a Supabase connection string
# placed in .env (one line: postgresql://user:password@host:port/db).
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 15+; the handoff schema is applied as the owner role)
# App connection: the ecofy_app role (RLS enforced). Used by web + worker.
DATABASE_URL=postgresql://ecofy_app.<project-ref>:<ecofy_app password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Owner connection: migrations, seed, schema tests, fixtures ONLY. Never used by the app.
OWNER_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# psql binary used by db scripts (seed needs psql meta-commands)
PSQL=C:\Program Files\PostgreSQL\15\bin\psql.exe

# --- Tenant hosts served by this deployment (comma separated; matched against the Host header)
TENANT_HOSTS=localhost:3000

# --- Supabase Auth (separate project for the Ecofy tenant)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 JWT secret. When empty the JWKS endpoint of the project is used.
SUPABASE_JWT_SECRET=

# --- Adapters: dev drivers need no credentials
STORAGE_DRIVER=local            # local | s3
MAIL_DRIVER=dev                 # dev | ses
SMS_DRIVER=dev                  # dev | gupshup
QUEUE_DRIVER=inline             # inline | bullmq

# local storage driver
LOCAL_STORAGE_DIR=.data/storage
LOCAL_SIGNING_SECRET=change-me-32-bytes-hex
APP_BASE_URL=http://localhost:3000

# s3 driver
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=ecofy/sandbox/

# ses driver
SES_FROM=no-reply@itarang.com

# gupshup driver
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=
SMS_WEBHOOK_SECRET=change-me

# bullmq driver
REDIS_URL=redis://localhost:6379

# --- Cookies / security
COOKIE_SECURE=false             # true in production (https)
SESSION_COOKIE_NAME=sb-access-token
REFRESH_COOKIE_NAME=sb-refresh-token
DEVICE_COOKIE_NAME=ecofy_device

# --- Seed bootstrap (iTarang Admin created by the seed)
SEED_IA_EMAIL=ia@ecofy.local
SEED_IA_NAME=iTarang Admin

# --- Logging
LOG_LEVEL=info

# Password given to the dev fixture users (npm run db:fixtures); generated when blank
DEV_FIXTURE_PASSWORD=
