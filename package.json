{
  "name": "ecofy-lead-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Ecofy Lead Workspace — CRM/LMS for Ecofy × iTarang (tenant #01 on the iTarang Lead Platform)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"next dev\" \"tsx watch src/worker/main.ts\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "next build && node scripts/postbuild.mjs",
        "start": "node .next/standalone/server.js",
    "start:worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:init-env": "node db/scripts/init-env.mjs",
    "db:apply-schema": "node db/scripts/apply-schema.mjs",
    "db:migrate": "node db/scripts/migrate.mjs",
    "db:schema-tests": "node db/scripts/run-schema-tests.mjs",
    "db:seed": "node db/scripts/seed.mjs",
    "db:fixtures": "tsx db/scripts/dev-fixtures.ts",
    "db:integration-user": "node --import tsx db/scripts/ensure-integration-user.ts",
    "db:pull": "drizzle-kit pull",
    "psql": "node db/scripts/psql.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/client-ses": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-query": "^5.90.19",
    "bullmq": "^5.71.1",
    "clsx": "^2.1.1",
    "croner": "^9.1.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.10.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.3",
    "pino": "^9.9.0",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "pino-pretty": "^13.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
